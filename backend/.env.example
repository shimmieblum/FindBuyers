# PredictLeads API (required for /api/news-events)
PREDICTLEADS_API_KEY=your_api_key_here
PREDICTLEADS_API_TOKEN=your_api_token_here

# Optional: override API base URL (default: https://api.predictleads.com)
# PREDICTLEADS_BASE_URL=https://predictleads.com/api/v3

# Server port (default: 3000)
PORT=3000

# API security / deployment
# - Keep Supabase service role keys server-side only (never exposed to browsers).
# - In production, deploy behind HTTPS.
#
# CORS_ORIGINS can be used by a future CORS middleware to allow only specific origins.
# CORS_ORIGINS=http://localhost:5173
