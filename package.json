{
  "name": "findbuyers",
  "version": "1.0.0",
  "private": true,
  "description": "FindBuyers - full-stack app",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev -w findbuyers-backend",
    "dev:frontend": "npm run dev -w findbuyers-frontend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w findbuyers-backend",
    "build:frontend": "npm run build -w findbuyers-frontend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "axios": "^1.13.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
